# Copy to .env and fill in real values for local dev
DJANGO_SECRET_KEY=dev-change-me
GOOGLE_MAPS_API_KEY=YOUR_BROWSER_PLACES_KEY_HERE
TELEGRAM_BOT_TOKEN=your_bot_token_from_BotFather
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
# Optional locally — production uses webhook; dev uses telegram_poll (no secret needed)
# TELEGRAM_WEBHOOK_SECRET=
SITE_URL=http://127.0.0.1:8000
# Optional: for phone testing on same Wi-Fi (use your PC LAN IP, see runserver.bat output)
# DEV_SITE_URL=http://192.168.1.42:8000
# SITE_URL=http://192.168.1.42:8000
DJANGO_DEBUG=True
